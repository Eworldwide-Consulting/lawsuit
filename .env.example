# ── TriVanta Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# ─── MySQL Database (required in production) ──────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special chars in password (e.g. @ → %40, # → %23)
DATABASE_URL=mysql://u511005792_dbadmin:YOUR_PASSWORD@srv1619.hstgr.io:3306/u511005792_lawsuit

# ─── MySQL UNIX Socket (Hostinger shared hosting) ─────────────────────────────
# Set this to bypass TCP and connect via socket — required when the DB user only
# has localhost (socket) grants.  Find the path in phpMyAdmin SQL tab:
#   SHOW VARIABLES LIKE 'socket';
# Common Hostinger paths: /var/lib/mysql/mysql.sock  or  /tmp/mysql.sock
# Leave blank (or remove) to use TCP from DATABASE_URL above.
MYSQL_SOCKET=/var/lib/mysql/mysql.sock

# ─── Frontend / Server URLs ───────────────────────────────────────────────────
CLIENT_URL=https://gkasevault.io
SERVER_URL=https://gkasevault.io

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Gmail: enable 2FA → Security → App passwords → create one → paste below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Trivanta Legal" <your-gmail@gmail.com>

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://gkasevault.io/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads

# ─── Demo Account Seed Password (optional) ────────────────────────────────────
# If unset, a random password is generated on first seed and printed to the log.
# Set this to a known value so you can log in after seeding.
SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Stripe Payments (optional) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret