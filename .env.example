# ── TriVanta Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values before deploying.
# NEVER commit .env to git.

# Server
NODE_ENV=production
PORT=5000

# Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# Database (absolute path recommended for production)
DB_PATH=./trivanta.db

# Frontend URL — set to your actual domain in production
CLIENT_URL=https://yourdomain.com

# File uploads
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads
