# ── TriVanta Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# ─── MySQL Database (required in production) ──────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special chars in password (e.g. @ → %40, # → %23)
DATABASE_URL=mysql://u511005792_dbadmin:YOUR_PASSWORD@srv1619.hstgr.io:3306/u511005792_lawsuit

# ─── MySQL UNIX Socket (Hostinger shared hosting) ─────────────────────────────
# Set this to bypass TCP and connect via socket — required when the DB user only
# has localhost (socket) grants.  Find the path in phpMyAdmin SQL tab:
#   SHOW VARIABLES LIKE 'socket';
# Common Hostinger paths: /var/lib/mysql/mysql.sock  or  /tmp/mysql.sock
# Leave blank (or remove) to use TCP from DATABASE_URL above.
MYSQL_SOCKET=/var/lib/mysql/mysql.sock

# ─── Frontend / Server URLs ───────────────────────────────────────────────────
CLIENT_URL=https://gkasevault.io
SERVER_URL=https://gkasevault.io

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Gmail: enable 2FA → Security → App passwords → create one → paste below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Trivanta Legal" <your-gmail@gmail.com>

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://gkasevault.io/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── Twilio SMS (optional — powers phone-based password reset) ───────────────
# Console: https://console.twilio.com
# If left blank, GET /api/auth/sms/status reports { configured: false } and the
# client hides the phone-reset tab — email reset keeps working either way.
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
# Prefer a Messaging Service SID (handles number pooling / A2P 10DLC compliance).
TWILIO_MESSAGING_SERVICE_SID=MGyour-messaging-service-sid
# Only set this if sending from a single raw phone number instead of a
# Messaging Service — never set both.
TWILIO_FROM_NUMBER=

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads

# ─── Demo Account Seed Password (optional) ────────────────────────────────────
# If unset, a random password is generated on first seed and printed to the log.
# Set this to a known value so you can log in after seeding.
SEED_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Stripe Payments ──────────────────────────────────────────────────────────
# The server validates the key prefix at startup and will THROW if:
#   - NODE_ENV=production but key starts with sk_test_
#   - NODE_ENV=development but key starts with sk_live_
#
# ── DEVELOPMENT / STAGING (test mode) ──
#   Get from: https://dashboard.stripe.com/test/apikeys
#   Webhook secret: stripe listen --forward-to localhost:5000/api/payments/webhook
#
# STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY
# STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY
# STRIPE_TEST_WEBHOOK_SECRET=whsec_YOUR_TEST_WEBHOOK_SIGNING_SECRET
#
# ── PRODUCTION (live mode) ──
#   Get from: https://dashboard.stripe.com/apikeys
#   Webhook secret: dashboard.stripe.com → Webhooks → your prod endpoint → Signing secret
#
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_LIVE_WEBHOOK_SIGNING_SECRET
# STRIPE_TEST_WEBHOOK_SECRET= (not needed in production — leave blank or omit)
#
# ── CI/CD note ──
#   Inject via your secrets manager (GitHub Actions → Settings → Secrets):
#     staging:    STRIPE_SECRET_KEY = sk_test_...  NODE_ENV=development
#     production: STRIPE_SECRET_KEY = sk_live_...  NODE_ENV=production
#
# ── Stripe test cards (never charge a real card in dev) ──
#   Success:              4242 4242 4242 4242  exp: any future  cvc: any
#   Auth required (3DS):  4000 0025 0000 3155
#   Card declined:        4000 0000 0000 9995
#   Insufficient funds:   4000 0000 0000 9995