# ── TriVanta Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values before deploying.
# NEVER commit .env to git.

# Server
NODE_ENV=production
PORT=5000

# Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# Database (absolute path recommended for production)
DB_PATH=./trivanta.db

# Frontend URL — set to your actual domain in production
CLIENT_URL=https://yourdomain.com

# Server URL (same as CLIENT_URL in production; http://localhost:5000 in dev)
SERVER_URL=https://yourdomain.com

# Google OAuth (get these from https://console.cloud.google.com)
# Authorized redirect URI to register: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# File uploads
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads
