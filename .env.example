# ── TriVanta Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values before running.
# NEVER commit .env to git.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# ─── Supabase (required) ──────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ─── Frontend URL ─────────────────────────────────────────────────────────────
CLIENT_URL=https://yourdomain.com
SERVER_URL=https://yourdomain.com

# ─── Email / SMTP (required for email verification) ───────────────────────────
# Gmail example: enable 2FA → create App Password → use below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="TriVanta" <noreply@yourdomain.com>

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Authorized redirect URI: https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./uploads

# ─── Stripe Payments (optional) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
